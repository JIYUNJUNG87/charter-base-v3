# ===== Python =====
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# ===== Virtual environment =====
venv/
env/
.venv/
ENV/

# ===== Build / dist =====
build/
dist/
*.egg-info/
*.egg

# ===== IDE / OS =====
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# ===== Streamlit =====
.streamlit/secrets.toml

# ===== Claude Code 로컬 설정 =====
.claude/

# ===== 환경 변수 / 비밀 =====
.env
.env.*
*.key
*.pem

# ===== 회사 운영 데이터 (절대 커밋 금지) =====
# data/ 안은 전부 무시하되, 데모용 합성 데이터 폴더만 예외 허용
# (data/ 자체를 통째로 ignore 하면 그 안의 ! 예외가 동작하지 않으므로 data/* 사용)
data/*
!data/master_demo/

# Excel/CSV 도 글로벌하게 차단 (실수로 다른 곳에 떨어뜨려도 차단)
*.xls
*.xlsx
*.xlsm
*.csv
*.parquet

# 단, master_demo 안의 Excel 은 허용 (합성 데이터, 실 운영 수치 아님)
!data/master_demo/*.xls
!data/master_demo/*.xlsx
!data/master_demo/*.md

# ===== 로그 / 임시 =====
*.log
logs/
tmp/
temp/

# ===== 테스트 결과물 =====
.pytest_cache/
.coverage
htmlcov/
